# Anthropic API Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# API authentication (set one)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Optional: custom endpoint URL (e.g., for enterprise/self-hosted deployments)
ANTHROPIC_BASE_URL=

# Optional: model override
# - Leave empty for standard Anthropic endpoint (defaults to claude-haiku-4-5-20251001)
# - Leave empty for custom endpoint (endpoint will use its deployment default)
# - Set to specific model name to override any default
ANTHROPIC_MODEL=